# Independent RabbitMQ settings; not read by PostgreSQL initialization.
# Copy to .env before the first run if you want to change these local values.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management-alpine
RABBITMQ_DEFAULT_USER=cinema_mq
RABBITMQ_DEFAULT_PASS=CinemaMqLocal123!
RABBITMQ_DEFAULT_VHOST=cinema
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
